# Скопируйте в .env:  cp .env.example .env
#
# Для Docker (npm run db:up) — значения ниже уже подходят:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=foodsource
DB_PASSWORD=foodsource
DB_NAME=foodsource
PORT=3000
SESSION_SECRET=change-me-in-production
#
# Если используете локальный MySQL с root:
# DB_USER=root
# DB_PASSWORD=ваш_пароль_root
