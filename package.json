{
  "name": "frontend-portfolio",
  "private": true,
  "description": "Корень репозитория. npm-скрипты FoodSource делегируются в food-suppliers/.",
  "scripts": {
    "foodsource": "npm --prefix food-suppliers",
    "start": "npm --prefix food-suppliers start",
    "stop": "npm --prefix food-suppliers run stop",
    "setup": "npm --prefix food-suppliers run setup",
    "db:up": "npm --prefix food-suppliers run db:up",
    "db:down": "npm --prefix food-suppliers run db:down",
    "db:wait": "npm --prefix food-suppliers run db:wait",
    "db:check": "npm --prefix food-suppliers run db:check",
    "db:reset": "npm --prefix food-suppliers run db:reset",
    "db:reload": "npm --prefix food-suppliers run db:reload",
    "db:fix-encoding": "npm --prefix food-suppliers run db:fix-encoding"
  }
}
